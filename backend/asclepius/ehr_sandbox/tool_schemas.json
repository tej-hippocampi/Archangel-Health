[
  {
    "name": "search_patients",
    "description": "Search patients by name, birth date, MRN or gender. Returns a FHIR Bundle of Patient.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "any part of the name, case-insensitive",
          "minLength": 1,
          "maxLength": 6000
        },
        "birthdate": {
          "type": "string",
          "description": "YYYY-MM-DD, optionally prefixed ge/le/eq",
          "minLength": 1,
          "maxLength": 6000
        },
        "identifier": {
          "type": "string",
          "description": "MRN, exact",
          "minLength": 1,
          "maxLength": 6000
        },
        "gender": {
          "type": "string",
          "enum": [
            "female",
            "male",
            "other",
            "unknown"
          ],
          "minLength": 1,
          "maxLength": 6000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Page size, maximum 200."
        },
        "page_token": {
          "type": "string",
          "description": "Copy the next-page cursor from the previous Bundle link; keep filters unchanged."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
