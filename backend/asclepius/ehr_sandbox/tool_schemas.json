  {
    "name": "search_observations",
    "description": "Search labs or vitals. Use a LOINC code (system|code or bare) or a group name (e.g. 'BMP','renal','UACR','CBC','iron','PTH'). Paginated.",
    "input_schema": {
      "type": "object",
      "properties": {
        "patient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "category": {
          "type": "string",
          "enum": [
            "laboratory",
            "vital-signs"
          ],
          "minLength": 1,
          "maxLength": 6000
        },
        "date_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "date_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "sort": {
          "type": "string",
          "enum": [
            "date",
            "-date"
          ],
          "default": "-date",
          "minLength": 1,
          "maxLength": 6000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "page_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      },
      "required": [
        "patient_id"
      ],
      "additionalProperties": false
    }
  },
