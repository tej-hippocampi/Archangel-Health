  {
    "name": "calculate",
    "description": "Deterministic clinical calculators. Use only retrieved patient values; omit calculations with missing inputs. Exact required inputs by formula: egfr_ckd_epi_2021_cr: creatinine_mg_dl, age, sex; egfr_ckd_epi_2021_cr_cys: creatinine_mg_dl, cystatin_c_mg_l, age, sex; crcl_cockcroft_gault: creatinine_mg_dl, age, sex, weight_kg; kfre_4var_2yr: egfr, uacr_mg_g, age, sex; kfre_4var_5yr: egfr, uacr_mg_g, age, sex; uacr_category: uacr_mg_g; ckd_stage: egfr; bmi: weight_kg, height_cm; unit_convert: value, from_unit, to_unit, analyte.",
    "input_schema": {
      "type": "object",
      "properties": {
        "formula": {
          "type": "string",
          "enum": [
            "egfr_ckd_epi_2021_cr",
            "egfr_ckd_epi_2021_cr_cys",
            "crcl_cockcroft_gault",
            "kfre_4var_2yr",
            "kfre_4var_5yr",
            "uacr_category",
            "ckd_stage",
            "bmi",
            "unit_convert"
          ],
          "minLength": 1,
          "maxLength": 6000
        },
        "inputs": {
          "type": "object",
          "description": "Provide exactly the inputs listed for the selected formula. Units are encoded in numeric field names; eGFR is mL/min/1.73m2. Never substitute assumed values.",
          "properties": {
            "age": {
              "type": "number",
              "minimum": 0
            },
            "analyte": {
              "type": "string",
              "description": "unit_convert: creatinine (mg/dL \u2194 umol/L), uacr (mg/g \u2194 mg/mmol), or glucose (mg/dL \u2194 mmol/L)."
            },
            "creatinine_mg_dl": {
              "type": "number",
              "minimum": 0
            },
            "cystatin_c_mg_l": {
              "type": "number",
              "minimum": 0
            },
            "egfr": {
              "type": "number",
              "minimum": 0
            },
            "from_unit": {
              "type": "string"
            },
            "height_cm": {
              "type": "number",
              "minimum": 0
            },
            "sex": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ]
            },
            "to_unit": {
              "type": "string"
            },
            "uacr_mg_g": {
              "type": "number",
              "minimum": 0
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "weight_kg": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "formula",
        "inputs"
      ],
      "additionalProperties": false
    }
  },
