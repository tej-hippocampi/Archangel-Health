# ═══════════════════════════════════════════════════════════
#  CareGuide — Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (voice synthesis) ────────────────────────────
ELEVENLABS_API_KEY=...
# Choose a warm, calm clinical voice from ElevenLabs voice library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Tavus (AI avatar) ────────────────────────────────────────
TAVUS_API_KEY=...
# Your licensed replica ID (the visual avatar face/body)
TAVUS_REPLICA_ID=r...

# ── Daily.co (human telehealth video) ─────────────────────────
VIDEO_PROVIDER=daily
DAILY_API_KEY=...
# Your Daily subdomain, e.g. yourteam.daily.co
DAILY_DOMAIN=yourteam.daily.co

# ── Twilio (SMS delivery) ────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...

# ── Email (SendGrid Web API — preferred for "Send to Patient") ────────
SENDGRID_API_KEY=SG....
# Verified sender address (e.g. noreply@archangelhealth.ai)
SENDGRID_FROM_EMAIL=noreply@archangelhealth.ai
# Same address must be verified in SendGrid (Single Sender or domain auth) or health-system onboarding OTP emails return 503.
# If you only completed Single Sender Verification for a personal Gmail, set SENDGRID_FROM_EMAIL to that exact address until your domain is authenticated.
SENDGRID_FROM_NAME=Archangel Health

# Recipient for landing lead-capture forms ("Request data" / "Provide data").
# Defaults to tejpatel@berkeley.edu when unset.
# LEAD_NOTIFY_EMAIL=tejpatel@berkeley.edu

# ── Email fallback (SMTP — only if SENDGRID_API_KEY not set) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── Demo mode (local / staging demos) ────────────────────────
# DEMO_MODE=1 enables seeded demo roster (see backend/main.py).
# TRIAGE demo tenant seed (Dr. Thompson / RN Castillo roster). Keep enabled for
# product demos; disable in production if you do not want TRIAGEDM data loaded.
# ENABLE_TRIAGE_DEMO=1
# Demo credential secrets (set strong values outside local dev).
# DEMO_DOCTOR_PASSWORD=...
# TRIAGE_DEMO_SURGEON_PASSWORD=...
# TRIAGE_DEMO_RN_PASSWORD=...
# The shared marketing landing demo user (DEMO_DOCTOR_EMAIL in main.py) is created on startup unless disabled:
# DISABLE_PUBLIC_DEMO_ACCOUNT=1
# DEMO_MODE=1
# Persist in-memory patient roster across restarts (JSON). Default on when DEMO_MODE=1; set 0 for a fresh roster every boot.
# DEMO_PERSIST_PATIENT_STORE=1
# Optional absolute path; default is backend/demo_patient_store.json next to main.py.
# DEMO_PATIENT_STORE_PATH=/var/data/demo_patient_store.json
# SQLite for episodes/surveys/events — use a mounted path in Docker so team activity survives redeploys.
# TEAM_DB_PATH=/var/data/team.db
# Intake bot v2 APIs + structured intake workflow (set 0 to disable quickly during rollout).
# ENABLE_PREOP_INTAKE_BOT_V2=1

# ── App ──────────────────────────────────────────────────────
# Public URL where patients will access their dashboard
BASE_URL=https://app.careguide.com
# Landing page URL (for "View your recovery plan" in patient emails). Required so patients get the code-entry page; if unset, the link goes to the patient dashboard directly.
# LANDING_URL=http://localhost:5173
# Secret for JWT signing (landing / Elysium Health auth + patient sessions).
# Use a long random string in production.
AUTH_SECRET=change-me-in-production-elysium
# Deployment environment. Set ENV=production to mark patient-session cookies
# Secure (HTTPS-only). Anything else (or unset) keeps cookies usable over plain
# http for local dev. Future PRDs also gate HSTS/HTTPS redirect on ENV=production.
# ENV=production
# Patient PHI access control (PRD-1). Default ON: patient routes require a patient
# session (entered via clinic_code + resource_code) or scoped clinical staff. Set
# to 0 ONLY for a brief staged rollback — it re-opens unauthenticated patient
# access and logs a warning on every such request. Remove once rollout is verified.
# ENFORCE_PATIENT_AUTH=1
# Care team callback number shown in the dashboard footer (fallback when doctor office_phone not set)
CARE_TEAM_PHONE=+1...

# ── HTTP security hardening (PRD-2) ──────────────────────────────────────────
# Comma-separated CORS allowlist. Defaults to BASE_URL + LANDING_URL when unset.
# In production, include the landing app origin so its cross-origin /api calls work.
# ALLOWED_ORIGINS=https://app.archangelhealth.ai,https://archangelhealth.ai
# Comma-separated Host allowlist (TrustedHostMiddleware). Only enforced when ENV=production.
# ALLOWED_HOSTS=app.archangelhealth.ai,archangelhealth.ai
# App-level HTTP->HTTPS redirect. OFF by default — HSTS + the platform edge already
# force HTTPS. Enable ONLY if uvicorn runs with --proxy-headers (it does in the
# Dockerfile/Procfile); otherwise it loops forever behind a TLS-terminating proxy.
# FORCE_HTTPS_REDIRECT=0
# Content-Security-Policy starts in report-only (1). Flip to 0 to enforce (phase 2).
# CSP_REPORT_ONLY=1
# Application-layer brute-force rate limiting on auth/code/OTP routes. Default on.
# RATE_LIMIT_ENABLED=1
# Require staff to have TOTP MFA enrolled before they can log in (PRD-3). Default
# off (MFA is opt-in per account). Turn on only after enrollment UI is rolled out,
# or unenrolled users will be blocked at login with a 403.
# REQUIRE_STAFF_MFA=0

# ── Subprocessor BAA gate (PRD-4) ────────────────────────────────────────────
# Set a flag to 1 ONLY once a signed Business Associate Agreement is actually on
# file for that vendor. Until then we send de-identified content (voice/avatar) or
# strip PHI (email). Anthropic first-party API and Twilio SMS default to covered.
# ANTHROPIC_BAA_SIGNED=1
# TWILIO_BAA_SIGNED=1
# SENDGRID is not HIPAA-eligible — leave this UNSET unless you truly have a BAA:
# SENDGRID_BAA_SIGNED=0
# ELEVENLABS_BAA_SIGNED=0
# TAVUS_BAA_SIGNED=0

# ── Encryption at rest (PRD-6) ───────────────────────────────────────────────
# AES-256-GCM field encryption for PHI written to disk (patient-store snapshot).
# Base64-encoded 32-byte key — generate with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Inject from a KMS / Secrets Manager in production. If unset, PHI fields are
# written unencrypted and the app relies on the platform's volume encryption only.
# DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_VERSION=1
# Key rotation: keep old keys here (decrypt-only) as "ver:base64,ver:base64".
# DATA_ENCRYPTION_KEY_RING=

# ── Asclepius — Expert Evaluation Portal (Product #3, standalone, no PHI) ─────
# Own SQLite DB (never touches team.db). Default: backend/asclepius.db
# ASCLEPIUS_DB_PATH=/var/data/asclepius.db
# Standalone JWT signing secret (independent of AUTH_SECRET). REQUIRED + strong
# (>=16 chars) in production; dev falls back to an ephemeral per-process secret.
ASCLEPIUS_AUTH_SECRET=change-me-asclepius
# Where export batches (JSONL + datasheet + dictionary + quality report) are written.
# ASCLEPIUS_EXPORT_DIR=/tmp/asclepius-exports
# Human-QA sampling rate (%). All flagged records are reviewed regardless. 0 = none, 100 = all.
ASCLEPIUS_QA_SAMPLE_PCT=15
# Submissions faster than this many seconds are flagged "too_fast" and routed to QA.
ASCLEPIUS_TIME_FLOOR_SEC=20
# Optional per-role model overrides (default claude-sonnet-4-6 via MODEL_REGISTRY):
# MODEL_ASCLEPIUS_CRITIC=claude-sonnet-4-6
# MODEL_ASCLEPIUS_CANDIDATE_GEN=claude-sonnet-4-6
# ── Seedmaker auto-generation (Mode A, nephrology v1 — PRD §11) ──
# Prompt synthesis + error-likelihood judging default to the strongest model
# (claude-opus-4-8) for highest-quality, high-value prompts. Override to a
# lighter model (e.g. claude-sonnet-4-6) only if cost/availability requires it.
# Candidate gen stays on the current (non-max) model so realistic, revisable
# errors are more likely.
# MODEL_ASCLEPIUS_PROMPT_GEN=claude-sonnet-4-6
# MODEL_ASCLEPIUS_PROMPT_JUDGE=claude-sonnet-4-6
# Quality gate: drop generated items below these judge scores (0..1).
ASCLEPIUS_GEN_MIN_ERROR_LIKELIHOOD=0.5
ASCLEPIUS_GEN_MIN_REVISION_VALUE=0.5
# Generation attempts before giving up on one task slot (avoids infinite loops).
ASCLEPIUS_GEN_MAX_ATTEMPTS_PER_TASK=4
# Seed exemplars sampled per prompt-generation call (few-shot K).
ASCLEPIUS_GEN_FEWSHOT_K=6
# Empty-queue autofill may generate MULTIMODAL cases (full case-gen + case-judge
# pipeline) before falling back to text corpus seeding. Off by default — opt in
# per deployment; a zero-yield multimodal batch still falls back to text, so the
# queue never starves. Verify the live path first: backend/scripts/smoke_multimodal.py
# ASCLEPIUS_AUTOFILL_MULTIMODAL=0
# ── Payments thresholds (LEAVE THESE ALONE IN PRODUCTION) ──
# Both are correct as they ship. They are listed here because both make a short
# live demo look broken, and the fix is staging, not code.
#
# Minimum credited seconds before a paired-review session qualifies for payout.
# Production default 1200 (20 min). A 10-minute walkthrough never reaches it, so
# the reviewer completes a full adjudication and earns nothing visible — which
# reads as "the payments system does not work". On a DEMO instance set 60, or
# pre-seed one qualified session so Earnings has a real row to show.
# ASCLEPIUS_TR_MIN_SECONDS=1200
#
# Minimum double-labeled observations before Cohen's κ is reportable. Below it
# the quality report says "kappa is not reportable below 30" instead of printing
# a number nobody should trust. That is the honest behaviour and it is worth
# saying out loud rather than letting a buyer discover it — but if you want a
# real κ on screen, seed 30+ double-labeled observations rather than lowering it.
# ASCLEPIUS_KAPPA_MIN_N=30
#
# ── Referral program ──
# Referrer bounty: $50 when a physician you referred is verified and completes
# their first accepted case. Stamped on the ledger at accrual; changing it never
# restates a bounty already earned.
# ASCLEPIUS_REFERRAL_BOUNTY_CENTS=5000
# Referee first-case bonus: $25 to the referred physician, same settlement.
# ASCLEPIUS_REFEREE_BONUS_CENTS=2500
# Per-referrer lifetime cap on bounties. 0 (the default) means NO CEILING, which
# is the point of the program: a physician who introduces us to a hundred
# colleagues and a health system should not hit a wall. Set a value here to
# reimpose a cap without a deploy.
# ASCLEPIUS_REFERRAL_CAP_CENTS=0
# Where the Referral tab's health-system / enterprise notes are emailed.
# ENTERPRISE_NOTE_EMAIL=aryaabhatia@berkeley.edu

# Bootstrap admin seeded on first boot if the user table is empty (rotate immediately):
# ASCLEPIUS_ADMIN_EMAIL=admin@asclepius.local
# ASCLEPIUS_ADMIN_PASSWORD=change-me-strong
# Seed a demo evaluator on first boot (local/demo convenience). Set 0 to disable.
# ASCLEPIUS_SEED_DEMO_EVALUATOR=1
# ASCLEPIUS_DEMO_EVALUATOR_EMAIL=evaluator@asclepius.local
# ASCLEPIUS_DEMO_EVALUATOR_PASSWORD=change-me-strong
# ASCLEPIUS_DEMO_EVALUATOR_SPECIALTY=nephrology
# ── Mock / sandbox contributor (internal demo tool) ──
# A stable evaluator login for exercising the LIVE portal (V3, multimodal cases)
# whose submissions are HARD-EXCLUDED from every export by default and labeled
# "Mock Contributor Account" in the admin. Provisioned idempotently on every boot
# (all environments). Surfaced in the admin Demo Credentials section with an
# "Open Asclepius portal" button. Set ASCLEPIUS_MOCK_ENABLED=0 to disable.
# Login is a plain username/id (the portal login accepts a username OR an email).
# ASCLEPIUS_MOCK_ENABLED=1
# ASCLEPIUS_MOCK_ID=mockadmin
# ASCLEPIUS_MOCK_PASSWORD=MockContributor-2026
# ASCLEPIUS_MOCK_SPECIALTY=nephrology
# ASCLEPIUS_MOCK_BOARD_CERT=board_certified_nephrology
# ASCLEPIUS_MOCK_YEARS=12
# ASCLEPIUS_MOCK_ORG=Archangel Health (Sandbox)
# ── Data optimization (opt prompt) ──
# Per-record rights attestation stamped on every exported record (opt §1.4).
# ASCLEPIUS_LICENSE=CC-BY-NC-4.0-clinical-eval
# ASCLEPIUS_IP_CLEARED=1
# % of tasks to double-label for Cohen's kappa inter-annotator agreement (opt §1.3).
# ASCLEPIUS_DOUBLE_LABEL_PCT=0
# Override the buyer-profile directory (default: backend/asclepius/buyer_profiles).
# ASCLEPIUS_PROFILES_DIR=

# ── Internal Tools ────────────────────────────────────────────
INTERNAL_TOOL_SECRET=change-me-internal-secret
# Admin portal login (admin.archangelhealth.ai)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Gold Standard — conversation-capture training data (Data Training tab) ───
# Backend mounted; UI box is a disabled placeholder for now. All vars optional
# (gold/config.py has safe defaults). Audio is PHI — leave STT BAA flags UNSET
# until a BAA is executed.
# STT_PROVIDER=whisper            # whisper | deepgram | stub
# WHISPER_API_KEY=sk-...          # or OPENAI_API_KEY
# WHISPER_MODEL=whisper-1
# DEEPGRAM_API_KEY=...
# DEEPGRAM_MODEL=nova-2-medical
# GOLD_DEID_PROVIDER=llm
# MODEL_GOLD_DRAFT_NOTE=claude-sonnet-4-6
# MODEL_GOLD_DEID=claude-sonnet-4-6
# GOLD_DEFAULT_SPECIALTY=general_surgery
# GOLD_AUDIO_RETENTION_DAYS=30
# GOLD_BAA_ON_FILE=1
# WHISPER_BAA_SIGNED=0
# DEEPGRAM_BAA_SIGNED=0
# ── Real EHR ingestion (EHR Ingestion PRD) — partner secure upload → V4 cases ──
# De-id verifier backend for inbound partner bundles: baseline (built-in scanner,
# default) | presidio | comprehend_medical (fall back to baseline if unavailable).
# ASCLEPIUS_DEID_VERIFIER=baseline
# Malware scan hook: any command run against the uploaded file; non-zero exit
# rejects (fail-closed). Without it, only structural zip checks run.
# ASCLEPIUS_MALWARE_SCAN_CMD=clamscan --no-summary
# Encrypted raw-upload quarantine dir + retention (derived cases are kept; the
# raw partner file auto-purges).
# ASCLEPIUS_INGEST_DIR=/data/asclepius-ingest
# ASCLEPIUS_RAW_RETENTION_DAYS=30
# Upload caps (zip-bomb defense).
# ASCLEPIUS_INGEST_MAX_ZIP_BYTES=104857600
# ASCLEPIUS_INGEST_MAX_ENTRIES=500
# ASCLEPIUS_INGEST_MAX_UNCOMPRESSED=524288000
# Data Provider Portal — email+password door (account flow, complements the
# magic-link uploader). Where the portal is reachable (invite email button →
# {URL}/provider); defaults to BASE_URL. And how long an invite (temp password)
# stays valid before it must be re-sent.
# ASCLEPIUS_PORTAL_URL=https://app.archangelhealth.ai
# ASCLEPIUS_PROVIDER_INVITE_TTL_DAYS=14
# Buyer secure data workspace (invite email button → {ASCLEPIUS_PORTAL_URL or
# BASE_URL}/workspace). How long a buyer's temp-password invite stays valid.
# ASCLEPIUS_BUYER_INVITE_TTL_DAYS=14
# REAL de-identified case value premium (the 2-3x tier; keys off case_source).
# ASCLEPIUS_VALUE_REAL_CASE_MULT=2.0

# ─── Asclepius Specialty Hyper-Personalization (cardiology + oncology) ────────
# The empirical-difficulty gate (the prime directive): a case ships only if
# frontier models FAIL it (wrong answer OR wrong reasoning). Measurement runs live
# frontier calls, so it is OFF by default and cases carry a DECLARED difficulty.
#
# STAGED ROLLOUT (Task Pipeline PRD §A). Two stages, and the order is the point:
#
#   Stage 1 (measure only)   MEASURE=1, REQUIRE=0, RELAX_MM_GATES unchanged.
#       Every newly generated case carries a live-measured value and NOTHING is
#       blocked on it. This is a soak: it produces the distribution we have never
#       observed with live keys, and it cannot empty the serving queue.
#   Stage 2 (enforce)        REQUIRE=1 and ASCLEPIUS_V3_RELAX_MM_GATES=0.
#       Serving then refuses any case not live-measured at or above the floor,
#       and the strict multimodal quality floors apply again in full. Flip this
#       only after the stage-1 review in docs/DEPLOY_BACKEND_RAILWAY.md: it is a
#       config change with no code change, and it is gated on numbers rather
#       than on a date.
#
# COST: measurement spends real frontier tokens on EVERY generated case, roughly
# baseline_models (2) x attempts (2) frontier answers plus one judge call each,
# so about 8 LLM calls per case on full multimodal prompts. Under stage 2 a
# below-floor case is discarded AFTER that spend, so the effective cost per
# SHIPPED case is the measurement cost divided by the pass rate.
# ASCLEPIUS_MEASURE_EMPIRICAL_DIFFICULTY=0   # 1 = measure live at generation time (stage 1)
# ASCLEPIUS_MIN_EMPIRICAL_DIFFICULTY=0.5     # floor (fraction of frontier attempts that fail)
# ASCLEPIUS_EMPIRICAL_DIFFICULTY_ATTEMPTS=2  # attempts per provider
# Enforce a LIVE-measured floor at serving time (prod posture, stage 2). OFF =
# declared/authored seeds still serve in dev without frontier keys. With no
# reachable frontier key measurement returns measured=False and the case keeps
# its declared value; under stage 2 such a case is HELD, not served, which is the
# gate working as designed rather than a failure to investigate.
# ASCLEPIUS_REQUIRE_MEASURED_DIFFICULTY=0
# Stage 2 also restores the strict multimodal quality floors (necessity >= 0.8,
# hardness >= 0.75, coherence, ground truth). Defaults ON (relaxed) during
# bring-up; see the V3 section for the flag itself.
# ASCLEPIUS_V3_RELAX_MM_GATES=1
# Force a fraction of every specialty's cases to admit a plausible-but-faulty
# reasoning path to the correct answer (the reasoning trace carries the value).
# ASCLEPIUS_REQUIRE_FAULTY_REASONING=0

# ─── Asclepius V4 image embedding (real de-identified imaging) ────────────────
# Content-addressed asset store for cleaned images (bytes NEVER in asclepius.db).
# ASCLEPIUS_ASSET_STORE=/var/data/asclepius-assets   # local path (or s3:// future)
# ASCLEPIUS_IMAGE_MAX_BYTES=26214400   # 25 MB upload cap
# ASCLEPIUS_IMAGE_MAX_DIM=4000         # downscale over this longest edge (px)
# ASCLEPIUS_IMAGE_KEEP_PDF=0           # keep the original PDF beside the raster
# Optional, DEFAULT-OFF OCR backstop: FLAGS (never blocks) an image whose text
# looks like a burned-in identifier for admin review. Not a de-id gate (§9).
# ASCLEPIUS_IMAGE_BURNIN_SCAN=0

# ─── Onboarding v2: the demo video (PRD §0.1, §6 stop 2) ──────────────────────
# The 73 MB demo does NOT live in the repo. It lives in the asset store above,
# which on a managed host MUST be a mounted persistent volume — on Railway that
# means adding a Volume and pointing ASCLEPIUS_ASSET_STORE at its mount path.
# Without one the container filesystem is wiped on every redeploy and the video
# 404s the next time you ship (the upload endpoint refuses outright rather than
# accepting bytes it knows will vanish).
#
# Upload it once per re-record, from your laptop:
#   python3 backend/scripts/upload_onboarding_demo.py \
#       --base-url https://<your-api-host> --email <an admin> --file demo.mp4
# ASCLEPIUS_MEDIA_MAX_BYTES=536870912   # 512 MB cap on a media upload
# The vision A/B sends real de-identified images to OpenAI — a logged compliance
# decision. Required ON for V4 image cases (see the subprocessor register).
# ASCLEPIUS_TWO_FRONTIER_V4=0
# OPENAI_BAA_SIGNED=0                   # flip when a BAA with OpenAI is executed

# ─── Community engagement ────────────────────────────────────────────────────
# These were documented only in docs/COMMUNITY.md and were missing here
# entirely, which is how the news digest ended up built, tested and switched
# off in production without anyone noticing.
#
# ⚠ Setting them HERE does not turn anything on. Nothing in the backend calls
# load_dotenv(); this file is a reference for humans. Only a variable set in
# the Railway dashboard reaches the running process. Both flags below default
# to OFF in code, so an unset variable means the routine does not run.
# GET /internal/community/status reports what actually resolved.

# The daily medical-AI digest: posts to #medical-ai-news AND emails members
# whose preference is 'daily'. OFF unless set to 1 (backend/community/digest.py).
COMMUNITY_NEWS_ENABLED=1
# Hour (UTC) the news digest runs. Papers ride the same hour, weekly.
COMMUNITY_DIGEST_NEWS_HOUR_UTC=13
# Day of week for the weekly papers digest (0 = Monday).
COMMUNITY_DIGEST_PAPERS_DOW=0

# ── The morning routine ──────────────────────────────────────────────────────
# Each channel gets one brief a day at 7am LOCAL: events a doctor could
# attend, medical-AI news with the summary attached, and an open research
# opportunity. Country channels fire on their own country's clock.
#
# The schedule lives in .github/workflows/community-morning.yml, which calls
# POST /internal/community/run-morning hourly; the endpoint decides what is
# due. That needs two repository secrets: MORNING_BASE_URL and the same
# INTERNAL_TOOL_SECRET this backend has.
#
# Off by default. Turning it on also stands the older news-digest EMAIL down,
# because the morning email carries the digest and two automated emails on the
# same morning is one too many. The in-app digest post is unaffected.
COMMUNITY_MORNING_ENABLED=0
# Local hour the brief lands.
COMMUNITY_MORNING_HOUR_LOCAL=7
# The clock for content that belongs to no single country.
ARCHANGEL_HOME_TZ=America/New_York
# How many colleagues a country needs before its channel appears. A room with
# one person in it reads as an empty building.
COMMUNITY_COUNTRY_MIN_MEMBERS=3
# Events per morning post.
COMMUNITY_EVENTS_MAX=3
# Day of week for the weekly discussion prompt in #future-of-medical-ai.
COMMUNITY_DISCUSSION_DOW=2
# How many searches one sourcing call may run, on the Anthropic tool path.
COMMUNITY_WEBSEARCH_MAX_USES=5

# ─── Morning sourcing: which retrievers find the content ─────────────────────
# Comma-separated, in merge order. Default "anthropic" is the server-side
# web-search tool alone, which is how this shipped. Add the paid rungs to widen
# the index: nobody publishes an RSS feed of "nephrology conferences in Saudi
# Arabia in the next two months", and that is exactly what a doctor would click.
#
#   COMMUNITY_SEARCH_PROVIDERS=exa,firecrawl,anthropic
#
# Exa and Firecrawl are RETRIEVERS: they return results, and the model is then
# asked to select among them. That makes the citation gate stronger, not weaker,
# because the allowlist is a set built from a search response rather than one
# parsed back out of the model's own prose.
COMMUNITY_SEARCH_PROVIDERS=anthropic
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# Paid searches per provider per UTC day. Counts CALLS, not dollars: pricing
# drifts and a spend figure the code cannot verify would read as a guarantee.
# 0 disables the ceiling. The ledger is durable, so a restart does not hand the
# day a fresh budget.
COMMUNITY_SEARCH_DAILY_CALL_CAP=40

# ─── Quality-adjusted pay ────────────────────────────────────────────────────
# OFF by default, and deliberately so: turning it on changes what physicians are
# paid, and that should be a decision made on a particular day rather than a
# side effect of a deploy. While it is off, every case pays the posted rate
# exactly as before, and the per-case quality metric keeps being computed and
# stamped, so switching it on later starts with a history rather than cold.
#
# Before switching this on, read docs/asclepius/QUALITY_ADJUSTED_PAY.md. It is
# algorithmic management of contractor compensation and the counsel memo on
# algorithmic tiering (docs/PRD_C_COUNSEL_MEMO.md) does not currently cover pay.
ASCLEPIUS_PAYOUT_QUALITY_ENABLED=0
# Never pay less than this share of the posted rate for a completed case.
ASCLEPIUS_PAYOUT_FLOOR=0.60
# The most a case can pay. Above 1.0 on purpose: paying more for a hard case
# done excellently is the incentive, and upside never takes money off somebody
# who delivered.
ASCLEPIUS_PAYOUT_CEILING=1.25

# ── The payout RAIL (Stripe Connect Express) ─────────────────────────────────
# OFF by default. This is the switch that lets real money leave, so it stays
# dark until a human has done the two things a deploy cannot do: enable Connect
# on the Stripe account and clear its KYC review. While it is 0, physicians see
# the same "coming soon" bank card they see today, no Stripe call is ever made,
# and the webhook route 404s.
#
# Turning it on with either key below missing fails loudly at the first Stripe
# call rather than degrading into a silent no-payout state, because a payout
# rail that quietly does nothing is worse than one that is visibly off.
#
# We never store a bank account number, a routing number, an SSN, an EIN or a
# TIN. Stripe collects tax identity during Express onboarding and files the
# 1099-NECs. All this codebase keeps is the connected account id and a status.
ASCLEPIUS_STRIPE_ENABLED=0
# STRIPE_SECRET_KEY=sk_live_...          # restricted key: Connect + Transfers
# STRIPE_WEBHOOK_SECRET=whsec_...        # from the endpoint you register at
#                                        # POST {BASE_URL}/api/asclepius/stripe/webhook

# How often the asclepius task-notify outbox is drained. The outbox is durable;
# this is what makes delivery durable too, instead of riding one background
# task with no retry.
ASCLEPIUS_TASK_NOTIFY_INTERVAL_SECONDS=60
# Cap on stories per digest, and on the model's output length.
COMMUNITY_DIGEST_MAX_ITEMS=15
COMMUNITY_DIGEST_MAX_TOKENS=1200
# Override the RSS sources. Comma-separated key=url.
# COMMUNITY_NEWS_FEEDS=stat-ai=https://...,medcitynews=https://...

# How often queued community activity (mentions, DMs, broadcasts) is flushed
# into one email per member. Floor is 15s.
COMMUNITY_DIGEST_INTERVAL_SEC=300
# How long before an event starts its interested members are reminded.
COMMUNITY_EVENT_REMINDER_MIN=60
# Members needed before a specialty gets its own auto-created channel.
COMMUNITY_SPECIALTY_MIN_MEMBERS=3

# Unsubscribe links and community URLs are built from this. Without it, the
# digest email's unsubscribe link is relative and therefore dead.
# PUBLIC_BASE_URL=https://app.archangelhealth.ai

# ─── Verification agent ──────────────────────────────────────────────────────
# Runs on every signup: builds a credential dossier, writes a recommendation,
# and alerts an admin. ON by default.
ASCLEPIUS_VERIFY_AGENT_ENABLED=1
# Whether the agent may WRITE an approval rather than only recommend one.
# OFF deliberately. Turn this on after reading a batch of dossiers and agreeing
# with them. Note it cannot fire at all until an OIG exclusion snapshot is
# loaded, because an unchecked exclusion is not a passed one.
ASCLEPIUS_VERIFY_AGENT_AUTO_APPROVE=0
ASCLEPIUS_VERIFY_AGENT_INTERVAL_SECONDS=30
# Grace window before a new-signup alert sends. The agent normally reports well
# inside this and enriches the queued alert in place.
ASCLEPIUS_ADMIN_ALERT_GRACE_SECONDS=120
# Who gets signup alerts. Falls back to ASCLEPIUS_ADMIN_EMAIL, then to every
# active admin account.
# ASCLEPIUS_ADMIN_NOTIFY_EMAILS=founder@example.com,ops@example.com

# ── Founder notifications ────────────────────────────────────────────
# Who hears when something happens on the product: a case submitted, a review
# finished, a referral sent, a health system signing up, filling in the
# questions, or uploading. Queued to the same durable outbox as the signup
# alerts and drained by the same 60s loop, so a mail outage delays them rather
# than losing them.
#
# Resolution order, and the fallbacks matter: a notification feature that
# silently no-ops because one var is unset is worse than not having one.
#   FOUNDER_NOTIFY_EMAILS -> ASCLEPIUS_ADMIN_NOTIFY_EMAILS
#     -> ASCLEPIUS_ADMIN_EMAIL -> every active admin account
#     -> the built-in default (both founders)
# FOUNDER_NOTIFY_EMAILS=aryaabhatia@berkeley.edu,tejpatel@berkeley.edu
#
# Work events roll up per person into a window (15 min for cases and reviews,
# 5 for referrals and uploads) so an evening of labelling is one mail and not
# twelve. Signups and intake go immediately: someone is waiting on a reply.
# Windows live in backend/notifications.py.

# ─── Provisional access ──────────────────────────────────────────────────────
# Lets a physician awaiting credential verification into the product (practice
# case + community, never real cases or earnings). Set to 0 to restore the old
# behavior of holding them on a waiting screen.
ASCLEPIUS_PROVISIONAL_ACCESS=1
